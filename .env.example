# Insert-only Postgres login for booking leads (Supabase pooler, session mode, port 5432).
# Leave empty locally: leads are then printed to the console instead of saved.
DATABASE_URL=

# Admin area (/admin): login for the rentife_admin_app role (Supabase pooler, session mode, port 5432), and a random 32+ character key
# that signs admin session cookies and encrypts authenticator secrets.
DATABASE_ADMIN_URL=
SESSION_SECRET=

# Supabase project "Rentife" (eu-west-1). The anon key is safe in the browser; the service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site address, used for the sitemap, robots.txt and canonical links.
NEXT_PUBLIC_SITE_URL=https://rentife.co.ke

# Resend key limited to sending from rentife.co.ke (team invitation emails).
RESEND_API_KEY=

# Photo-of-register import (Claude). Leave empty to keep it switched off. Set AI_REGISTER_IMPORT=off to disable with a key present.
ANTHROPIC_API_KEY=
AI_REGISTER_IMPORT=
