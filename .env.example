# Insert-only Postgres login for booking leads (Supabase transaction pooler, port 6543).
# Leave empty locally: leads are then printed to the console instead of saved.
DATABASE_URL=

# Admin area (/admin): login for the rentife_admin_app role, and a random 32+ character key
# that signs admin session cookies and encrypts authenticator secrets.
DATABASE_ADMIN_URL=
SESSION_SECRET=
